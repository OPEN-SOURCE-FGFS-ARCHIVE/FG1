<?xml version="1.0" encoding="iso-8859-1"?>

<PropertyList>

  <enable3d>true</enable3d>

  <ladder>
    <name>Pitch Ladder</name>
    <type>pitch</type>
    <x>-18</x>
    <y>-20</y>
    <width>40</width>
    <height>40</height>
    <roll-input>
      <property>/orientation/roll-deg</property>
    </roll-input>
    <pitch-input>
      <property>/orientation/pitch-deg</property>
    </pitch-input>
    <compression-factor>11.50</compression-factor>
    <display-span>5</display-span>
    <divisions>2.0</divisions>
    <screen-hole>6</screen-hole>
    <tick-length>2</tick-length>
    <zero-bar-overlength>15</zero-bar-overlength>
    <enable-dive-bar-angle>true</enable-dive-bar-angle>
    <enable-dynamic-origin>false</enable-dynamic-origin>
    <enable-fuselage-ref-line>true</enable-fuselage-ref-line>
    <enable-target-spot>false</enable-target-spot>
    <enable-target-markers>true</enable-target-markers>
    <enable-velocity-vector>true</enable-velocity-vector>
    <enable-drift-marker>false</enable-drift-marker>
    <enable-alpha-bracket>false</enable-alpha-bracket>
    <enable-energy-marker>false</enable-energy-marker>
    <enable-climb-dive-marker>false</enable-climb-dive-marker>
    <enable-glide-slope-marker>true</enable-glide-slope-marker>
    <glide-slope>0.0</glide-slope>
    <enable-energy-worm>false</enable-energy-worm>
    <enable-waypoint-marker>true</enable-waypoint-marker>
    <enable-zenith>false</enable-zenith>
    <enable-nadir>true</enable-nadir>
  </ladder>

  <turn-bank-indicator>
    <name>Turn Indicator</name>
    <x>-50</x>
    <y>-55</y>
    <width>100</width>
    <height>100</height>
    <bank-input>
      <property>/orientation/roll-deg</property>
    </bank-input>
    <sideslip-input>
      <property>/orientation/side-slip-deg</property>
    </sideslip-input>
    <bank-scale>true</bank-scale>
    <option>bottom</option>
  </turn-bank-indicator>

  <label>
    <name>Gyro Heading Label</name>
    <x>-7</x>
    <y>15</y>
    <width>18</width>
    <height>8</height>
    <input>
      <property>/orientation/heading-magnetic-deg</property>
    </input>
    <format>%3.0f</format>
    <halign>center</halign>
    <box>true</box>
    <option>top</option>
  </label>

  <tape>
    <name>Gyrocompass</name>
    <input>
      <property>/orientation/heading-magnetic-deg</property>
      <factor>0.1</factor>
    </input>
    <x>-37</x>
    <y>26</y>
    <width>40</width>
    <height>7</height>
    <display-span>4.0</display-span>
    <modulo>36</modulo>
    <option>top</option>
    <label-gap-width>10</label-gap-width>
    <major-divisions>1.0</major-divisions>
    <minor-divisions>0.5</minor-divisions>
    <tick-bottom>false</tick-bottom>
    <tick-top>false</tick-top>
    <tick-right>false</tick-right>
    <tick-left>false</tick-left>
    <cap-bottom>false</cap-bottom>
    <cap-top>false</cap-top>
    <cap-right>false</cap-right>
    <cap-left>false</cap-left>
    <marker-offset>1.0</marker-offset>
    <enable-pointer>false</enable-pointer>
    <pointer-type>fixed</pointer-type>
    <tick-type>line</tick-type>
    <tick-length>variable</tick-length>
  </tape>

  <label>
    <name>KIAS</name>
    <x>-52</x>
    <y>12</y>
    <width>30</width>
    <height>1</height>
    <input>
      <property>/velocities/airspeed-kt</property>
    </input>
    <format>%4.0fkt</format>
    <halign>left</halign>
    <box>false</box>
  </label>

  <label>
    <name>MACH Number</name>
    <x>-52</x>
    <y>5</y>
    <width>1</width>
    <height>1</height>
    <condition>
      <greater-than>
        <property>/velocities/mach</property>
        <value>0.70</value>
      </greater-than>
    </condition>
    <input>
      <property>/velocities/mach</property>
    </input>
    <format>%4.2f</format>
    <halign>left</halign>
  </label>

  <label>
    <name>Altitude</name>
    <x>39</x>
    <y>12</y>
    <width>18</width>
    <height>1</height>
    <input>
      <property>instrumentation/altimeter/indicated-altitude-ft</property>
    </input>
    <format>%6.0fft</format>
    <halign>right</halign>
    <box>false</box>
    <option>left</option>
  </label>

  <label>
    <name>flight level</name>
    <x>30</x>
    <y>0</y>
    <width>18</width>
    <height>1</height>
    <condition>
      <greater-than>
        <property>instrumentation/altimeter/indicated-altitude-ft</property>
        <value>20000</value>
      </greater-than>
    </condition>
    <input>
      <property>instrumentation/altimeter/indicated-altitude-ft</property>
      <factor>0.01</factor>
    </input>
    <format>FL %3.0f</format>
    <halign>right</halign>
    <box>false</box>
    <option>left</option>
  </label>

  <label>
    <name>elevationOk</name>
    <x>34</x>
    <y>-6</y>
    <condition>
      <less-than>
        <property>/position/altitude-agl-ft</property>
        <value>5000</value>
      </less-than>
    </condition>
    <halign>left</halign>
    <format>%5.0f</format>
    <input>
      <property>/position/altitude-agl-ft</property>
    </input>
  </label>

  <label>
    <name>AoA</name>
    <x>55</x>
    <y>19</y>
    <condition>
      <or>
        <greater-than>
          <property>/orientation/alpha-deg</property>
          <value>2.0</value>
        </greater-than>
        <and>
          <property>/controls/gear/gear-down</property>
          <greater-than>
            <property>/orientation/alpha-deg</property>
            <value>-1.0</value>
          </greater-than>
        </and>
      </or>
    </condition>
    <width>1</width>
    <height>1</height>
    <halign>right</halign>
    <format>AoA %3.1f</format>
    <input>
      <property>/orientation/alpha-deg</property>
    </input>
  </label>

  <label>
    <name>Gear</name>
    <x>-50</x>
    <y>-55</y>
    <width>15</width>
    <height>6</height>
    <condition>
      <property>/controls/gear/gear-down</property>
    </condition>
    <format>gears</format>
    <halign>left</halign>
  </label>

  <label>
    <name>Parking Break</name>
    <x>-50</x>
    <y>-50</y>
    <width>15</width>
    <height>6</height>
    <condition>
      <property>/controls/gear/brake-parking</property>
    </condition>
    <format>brakes</format>
    <halign>left</halign>
  </label>

  <label>
    <name>G Load</name>
    <x>-50</x>
    <y>19</y>
    <width>1.5</width>
    <height>1.5</height>
    <input>
      <property>/accelerations/pilot/z-accel-fps_sec</property>
      <factor>-0.03108095</factor>
      <damp>1.0</damp>
    </input>
    <format>%2.1fg</format>
    <halign>left</halign>
  </label>

  <label>
    <name>StallAlert</name>
    <x>-35</x>
    <y>-5</y>
    <width>15</width>
    <height>6</height>
    <condition>
      <equals>
        <property>/sim/alarms/stall-warning</property>
        <value>2</value>
      </equals>
    </condition>
    <format>STALL ALERT !</format>
    <blinking>
      <interval>0.1</interval>
    </blinking>
    <halign>left</halign>
  </label>

  <label>
    <name>StallWarning</name>
    <x>-36</x>
    <y>-5</y>
    <width>15</width>
    <height>6</height>
    <condition>
      <equals>
        <property>/sim/alarms/stall-warning</property>
        <value>1</value>
      </equals>
    </condition>
    <format>STALL WARNING !</format>
    <blinking>
      <interval>0.25</interval>
    </blinking>
    <halign>left</halign>
  </label>

  <label>
    <name>elevationWarn</name>
    <x>0</x>
    <y>0</y>
    <condition>
      <and>
        <equals>
          <property>/controls/gear/gear-down</property>
          <value>false</value>
        </equals>
        <less-than>
          <property>/position/altitude-agl-ft</property>
          <value>1000</value>
        </less-than>
        <less-than>
          <property>/instrumentation/vertical-speed-indicator/indicated-speed-kts</property>
          <value>0</value>
        </less-than>
      </and>
    </condition>
    <halign>center</halign>
    <format>PULL UP ! %5.0fft</format>
    <input>
      <property>/position/altitude-agl-ft</property>
    </input>
    <blinking>
      <interval>0.25</interval>
    </blinking>
  </label>

  <label>
    <name>Target Callsign</name>
    <x>-46</x>
    <y>-20</y>
    <condition>
      <greater-than>
        <property>/instrumentation/FGUKRadar/hud/target-range-nm</property>
        <value>0</value>
      </greater-than>
    </condition>
    <width>18</width>
    <height>1</height>
    <halign>left</halign>
    <format>%s</format>
    <input>
      <property>/instrumentation/FGUKRadar/hud/target-callsign</property>
    </input>
  </label>

  <label>
    <name>Target Range</name>
    <x>-46</x>
    <y>-28</y>
    <condition>
      <greater-than>
        <property>/instrumentation/FGUKRadar/hud/target-range-nm</property>
        <value>0</value>
      </greater-than>
    </condition>
    <width>18</width>
    <height>1</height>
    <halign>left</halign>
    <format>%2.1fnm</format>
    <input>
      <property>/instrumentation/FGUKRadar/hud/target-range-nm</property>
    </input>
  </label>

  <label>
    <name>Target Altitude</name>
    <x>-46</x>
    <y>-36</y>
    <condition>
      <greater-than>
        <property>/instrumentation/FGUKRadar/hud/target-range-nm</property>
        <value>0</value>
      </greater-than>
    </condition>
    <width>18</width>
    <height>1</height>
    <halign>left</halign>
    <format>%1.0fft</format>
    <input>
      <property>/instrumentation/FGUKRadar/hud/target-altitude-ft</property>
    </input>
  </label>

  <label>
    <name>Target Bearing</name>
    <x>-46</x>
    <y>-44</y>
    <condition>
      <greater-than>
        <property>/instrumentation/FGUKRadar/hud/target-range-nm</property>
        <value>0</value>
      </greater-than>
    </condition>
    <width>18</width>
    <height>1</height>
    <halign>left</halign>
    <format>brg %1.0f</format>
    <input>
      <property>/instrumentation/FGUKRadar/hud/target-bearing-deg</property>
    </input>
  </label>

  <aiming-reticle>
    <x>-10</x>
    <y>-10</y>
    <width>20</width>
    <height>20</height>
    <condition>
      <greater-than>
        <property>/instrumentation/FGUKRadar/hud/target-range-nm</property>
        <value>0</value>
      </greater-than>
    </condition>
    <offset-x-input>
      <property>/instrumentation/FGUKRadar/hud/target-reticule-x</property>
    </offset-x-input>
    <offset-y-input>
      <property>/instrumentation/FGUKRadar/hud/target-reticule-y</property>
    </offset-y-input>
  </aiming-reticle>

</PropertyList>
