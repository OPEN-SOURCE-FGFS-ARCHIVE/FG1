<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <sim>
    <minimum-fg-version>2017.2.0</minimum-fg-version>
    <description>Royal Navy/ RAF FG1 Phantom II (YASim)</description>
    <long-description>V1.0 HDR ready</long-description>
    <author>HiTouch(3D instruments) Virtavia (3d Model), StuartC (FDM + assembly), Dave Culp, Avionyx, VooDoo DaVinci</author>
    <description>FG1-2 (YASim)</description>
    <status>V1.0 HDR</status>
    <flight-model archive="y">yasim</flight-model>
    <aero archive="y">FGR-yasim</aero>

    <fuel-fraction>1.0</fuel-fraction>

    <rating>
      <FDM type="int">3</FDM>
      <systems type="int">2</systems>
      <cockpit type="int">4</cockpit>
      <model type="int">4</model>
    </rating>

    <tags>
      <tag>fighter</tag>
      <tag>RAF</tag>
      <tag>1960s</tag>
      <tag>1970s</tag>
      <tag>1980s</tag>
      <tag>coldwar</tag>
      <tag>supersonic</tag>
      <tag>jet</tag>
      <tag>2-engine</tag>
      <tag>afterburner</tag>
      <tag>McDonald Douglas</tag>
    </tags>

    <sound>
      <path>Aircraft/FG1/Sounds/F4D-sound.xml</path>
    </sound>

    <model>
      <path archive="y">Aircraft/FG1/Models/FG1_Phantom.xml</path>
      <livery>
        <file type="string">DEFAULT XV470</file>
      </livery>
      <fgr2>
        <hdr>true</hdr>
        <als>false</als>
      </fgr2>
    </model>

    <rendering>
      <refl_correction type="string">-0.43</refl_correction>
      <fresnel-factor>0.4</fresnel-factor>
      <redout>
        <parameters>
          <blackout-onset-g>4.0</blackout-onset-g>
          <blackout-complete-g>8.0</blackout-complete-g>
        </parameters>
      </redout>
    </rendering>

    <previews>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Splashscreen/1.jpg</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Splashscreen/2.jpg</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Splashscreen/3.jpg</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Splashscreen/4.jpg</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Splashscreen/5.jpg</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Splashscreen/6.jpg</path>
      </preview>
    </previews>

    <view n="0">
      <internal archive="y">true</internal>
      <config>
        <pitch-offset-deg>-13.000</pitch-offset-deg>
        <x-offset-m archive="y">0</x-offset-m>
        <y-offset-m archive="y">1.33</y-offset-m>
        <z-offset-m archive="y">-5.5</z-offset-m>
        <default-field-of-view-deg>100</default-field-of-view-deg>
      </config>
    </view>

    <view n="100">
      <name>Weapons officer View</name>
      <internal archive="y">true</internal>
      <type>lookfrom</type>
      <config>
        <from-model type="bool">true</from-model>
        <x-offset-m archive="y">0</x-offset-m>
        <y-offset-m archive="y">1.62</y-offset-m>
        <z-offset-m archive="y">-4</z-offset-m>
        <default-field-of-view-deg>100</default-field-of-view-deg>
        <limits>
          <left>
            <heading-max-deg>-100</heading-max-deg>
            <x-offset-threshold-deg>0</x-offset-threshold-deg>
            <x-offset-max-m>0</x-offset-max-m>
          </left>
          <right>
            <heading-max-deg>100</heading-max-deg>
            <x-offset-threshold-deg>0</x-offset-threshold-deg>
            <x-offset-max-m>0</x-offset-max-m>
          </right>
          <enabled>1</enabled>
        </limits>
      </config>
    </view>

    <view n="101">
      <name>Pilot cam</name>
      <internal archive="y">false</internal>
      <config>
        <from-model type="bool">true</from-model>
        <from-model-idx type="int">0</from-model-idx>
        <x-offset-m archive="y">0</x-offset-m>
        <y-offset-m archive="y">1.42</y-offset-m>
        <z-offset-m archive="y">-5.95</z-offset-m>
        <pitch-offset-deg>0</pitch-offset-deg>
        <heading-offset-deg>180</heading-offset-deg>
        <default-field-of-view-deg>95</default-field-of-view-deg>
      </config>
    </view>

    <view n="102">
      <name>Over the shoulder</name>
      <internal archive="y">false</internal>
      <config>
        <from-model type="bool">true</from-model>
        <from-model-idx type="int">0</from-model-idx>
        <x-offset-m archive="y">0.3</x-offset-m>
        <y-offset-m archive="y">1.42</y-offset-m>
        <z-offset-m archive="y">-5.2</z-offset-m>
        <pitch-offset-deg>-3</pitch-offset-deg>
        <heading-offset-deg>9</heading-offset-deg>
        <default-field-of-view-deg>65</default-field-of-view-deg>
      </config>
    </view>



    <flaps>
      <setting>0.00</setting>
      <setting>0.50</setting>
      <setting>1.00</setting>
    </flaps>

    <airport>
      <runways>
        <start-offset-m>20</start-offset-m>
      </runways>
    </airport>

    <multiplay>
      <chat_display>1</chat_display>
      <generic>
        <bool n="36" type="bool" alias="/controls/engines/engine/throttle"/>
        <int n="0" alias="/controls/switches/nav-lights-switch"/>
        <int n="1" alias="/controls/switches/beacon-switch"/>
        <int n="2" alias="/controls/switches/landing-lights-switch"/>
        <int n="3" alias="/controls/switches/strobe-switch"/>
        <int n="4" alias="/controls/smoke"/>
        <int type="int" n="5">0</int>
        <int type="int" n="6">1</int>
        <int n="7" alias="/sim/crashed"/>
        <int n="8" alias="/systems/electrical/outputs/nav-lights">0</int>
        <int n="9" alias="/sim/model/lights/beacon/state">false</int>
        <int n="10" alias="/controls/electric/key-pos">0</int>

        <float n="0" alias="/instrumentation/doors/crew/position-norm"/>
        <float n="1" alias="/surface-positions/slat-pos-norm"/>
        <float n="2" alias="/surface-positions/left-flap-pos-norm"/>
        <float n="3" alias="/surface-positions/right-flap-pos-norm"/>
        <float n="4" alias="/velocities/airspeed-kt"/>
        <float n="6" alias="/environment/relative-humidity"/>
        <float n="7" alias="/position/altitude-agl-ft"/>
        <float n="8" alias="/engines/engine[0]/afterburner"/>
        <float n="9" alias="/engines/engine[1]/afterburner"/>
        <float n="10" alias="/engines/engine/egt-degf"/>
        <float n="11" alias="/engines/engine[1]/egt-degf"/>
        <float n="12" alias="/controls/state/low_level"/>
        <float n="13" alias="/orientation/alpha-deg"/>
        <float n="14" alias="/position/altitude-ft"/>
        <float n="15" alias="/environment/temperature-degc"/>
        <float n="16" alias="/velocities/mach"/>
        <float n="18" alias="/engines/engine[0]/nozzle-pos-norm"/>
        <float n="19" alias="/engines/engine[1]/nozzle-pos-norm"/>
        <float n="20" alias="/smoke/red"/>
        <float n="21" alias="/smoke/green"/>
        <float n="22" alias="/smoke/blue"/>
        <float n="23" alias="/smoke/particlepersec"/>
        <float n="24" type="double">0</float>
        <float n="25" type="double" alias="/instrumentation/doors/wings/position-norm"/>
        <float n="26" type="double" alias="/gear/tailhook/position-norm"/>
        <float n="27" alias="/instrumentation/doors/passenger/position-norm"/>
        <float n="29" alias="/surface-positions/chute-pos-norm"/>
        <float n="30" alias="/orientation/parachute-theta"/>
        <float n="31" alias="/orientation/parachute-phi"/>
        <float n="32" alias="/controls/flight/parachute"/>

        <string alias="/sim/weight[0]/selected" n="0"/>
        <string alias="/sim/weight[1]/selected" n="1"/>
        <string alias="/sim/weight[2]/selected" n="2"/>
        <string alias="/sim/weight[3]/selected" n="3"/>
        <string alias="/sim/weight[4]/selected" n="4"/>
        <string alias="/sim/weight[5]/selected" n="5"/>
        <string alias="/sim/weight[6]/selected" n="6"/>
        <string alias="/sim/weight[7]/selected" n="7"/>
        <string alias="/sim/weight[8]/selected" n="8"/>
      </generic>
    </multiplay>

    <flight-recorder>
      <replay-config type="int">0</replay-config>
      <config n="0" include="/Aircraft/Generic/flightrecorder/generic-jet.xml">
        <name type="string">FGR-2 Flight Recorder</name>
        <signal><type>float</type><property type="string">surface-positions/right-elevator-pos-norm</property></signal>
        <signal><type>float</type><property type="string">surface-positions/left-elevator-pos-norm</property></signal>
        <signal><type>float</type><property type="string">sim/model/door-positions/crew/position-norm</property></signal>
        <signal><type>float</type><property type="string">/instrumentation/doors/wings/position-norm</property></signal>
        <signal><type>float</type><property type="string">/surface-positions/chute-pos-norm</property></signal>
        <signal><type>float</type><property type="string">/orientation/parachute-theta</property></signal>
        <signal><type>float</type><property type="string">/orientation/parachute-phi</property></signal>
        <signal><type>float</type><property type="string">/controls/flight/parachute</property></signal>
        <signal><type>float</type><property type="string">/gear/tailhook/position-norm</property></signal>
        <signal><type>float</type><property type="string">/instrumentation/doors/crew/position-norm</property></signal>
        <signal><type>float</type><property type="string">/surface-positions/aileron-pos-norm</property></signal>
        <signal><type>float</type><property type="string">/controls/engines/engine/mixture</property></signal>
        <signal><type>float</type><property type="string">/engines/engine[0]/afterburner</property></signal>
        <signal><type>float</type><property type="string">/engines/engine[1]/afterburner</property></signal>
      </config>
    </flight-recorder>

    <help>
      <title>FG1</title>
      <key><name>d</name><desc>Open/Close canopy</desc></key>
      <key><name>D</name><desc>Extend/Retract Refuelling Probe</desc></key>
      <key><name>Ctrl-B</name><desc>Extend/Retract speed brake</desc></key>
      <key><name>F</name><desc>Wing Fold/Unfold</desc></key>
      <key><name>O</name><desc>Extend arresting hook</desc></key>
      <key><name>o</name><desc>Retract arresting hook</desc></key>
      <key><name>L</name><desc>HOLD to engage launch bar</desc></key>
      <key><name>C</name><desc>Carrier launch command</desc></key>
      <key><name>c</name><desc>Open dragchute</desc></key>
      <key><name>j</name><desc>Release dragchute</desc></key>
    </help>

    <menubar include="dialogs/F-4EJ_ADTW-menu.xml"/>

    <hud>
      <path n="1">Aircraft/FG1/HUD/hud.xml</path>
      <visibility n="1">true</visibility>
      <clipping>
        <left type="double">-60</left>
        <right type="double">60</right>
        <top type="double">33</top>
        <bottom type="double">-56</bottom>
      </clipping>
      <font>
        <size>6</size>
        <name>default.txf</name>
      </font>
    </hud>

    <ai>
      <scenario>refueling_demo</scenario>
      <scenario>
        <path>Aircraft/FG1/AI/EGOD_arrestor_cables.xml</path>
      </scenario>
    </ai>

